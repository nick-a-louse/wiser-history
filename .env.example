# Copy to /srv/wiser/.env on your server and fill in. Never commit .env. Create it locked down BEFORE writing secrets into it:
#   install -m 600 /dev/null .env
# .env is gitignored - verify with: git check-ignore -v .env

TZ=Europe/London

# --- Container user (same as my other containers) -----------------------------
# Docker runs both containers as this user and group. /opt/appdata/wiser must
# be owned by them:  sudo chown -R 1003:1006 /opt/appdata/wiser
PUID=1003
PGID=1006

# --- Wiser hub -------------------------------------------------------------
WISER_HUB_IP=192.168.1.50
WISER_SECRET=

# --- OpenWeatherMap (One Call 4.0) ----------------------------------------
# Set "Calls per day (no more than)" to 1000 in the OWM billing settings:
# OWM bills for overage by default rather than refusing the call.
OWM_API_KEY=

# --- Open-Meteo (hourly sunlight, rain and snow; no key needed) -------------
# Free for non-commercial use. Back-fills hourly history into weather_hourly,
# then tops it up. A failure here never stops the hub being polled.
# OPENMETEO_ENABLED=1          # 0 to turn it off
# OPENMETEO_EVERY_HOURS=6      # how often to sync (a failed sync retries after 1 hour)
# OPENMETEO_RECENT_DAYS=7      # recent days taken from the forecast API until the archive catches up
# OPENMETEO_START=             # first day to back-fill, YYYY-MM-DD; empty = the day logging began

# --- AWS -------------------------------------------------------------------
# Standard names, so boto3 picks these up with no credential-handling code.
# The IAM user needs s3:PutObject on the bucket and nothing else.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-2
S3_BUCKET=

# --- Optional tuning -------------------------------------------------------
# POLL_SECONDS=300            # hub poll interval
# WEATHER_EVERY_N_POLLS=3     # weather every 15 min
# S3_EVERY_N_POLLS=12         # mirror to S3 hourly
# DB_BACKUP_EVERY_N_POLLS=288 # gzip the DB to S3 daily
# METRICS_PORT=9109
# LOG_LEVEL=INFO
