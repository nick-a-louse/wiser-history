# Copy to /srv/wiser/.env on gomez and fill in. Never commit .env. Create it locked down BEFORE writing secrets into it:
#   install -m 600 /dev/null .env
# .env is gitignored - verify with: git check-ignore -v .env

TZ=Europe/London

# --- Container user (same as the rest of gomez) -----------------------------
# Docker runs both containers as this user and group. /opt/appdata/wiser must
# be owned by them:  sudo chown -R 1003:1006 /opt/appdata/wiser
PUID=1003
PGID=1006

# --- Wiser hub -------------------------------------------------------------
WISER_HUB_IP=192.168.1.50
WISER_SECRET=

# --- OpenWeatherMap (One Call 4.0) ----------------------------------------
# Set "Calls per day (no more than)" to 1000 in the OWM billing settings:
# OWM bills for overage by default rather than refusing the call.
OWM_API_KEY=

# --- AWS -------------------------------------------------------------------
# Standard names, so boto3 picks these up with no credential-handling code.
# The IAM user needs s3:PutObject on the bucket and nothing else.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-2
S3_BUCKET=

# --- Optional tuning -------------------------------------------------------
# POLL_SECONDS=300            # hub poll interval
# WEATHER_EVERY_N_POLLS=3     # weather every 15 min
# S3_EVERY_N_POLLS=12         # mirror to S3 hourly
# DB_BACKUP_EVERY_N_POLLS=288 # gzip the DB to S3 daily
# METRICS_PORT=9109
# LOG_LEVEL=INFO
